;
; This file is included in the main boot code as well
; as in the overlay module.
;
; In the main boot code it actually provides the
; routines and variable space.
; In the overlay modules it just defines the
; addresses of the shared code and variables.
;

BOOT_LENGTH	=256

;--------------------------------------------------------
; common definitions

; default I/O
VCTRL		=$e807
MCTRL		=$e801
BANK		=$e802
SPEED		=$e803
BUSWIN		=$e804
VMAP		=$e805

R8296		=$fff0

; default map/bank
MAP_BAS		=0

; bank addresses for the various extensions
; see README.md for details

; bank and address in bank where the monitor code resides
MONBANK		=15
MONBASE		=$5000;

; bank and address in bank where the USB code resides
USBBANK		=15
USBBASE		=$1000

; bank and address in bank where the IOEXT code resides
IOEBANK		=15
IOEBASE		=$7000

; bank and address in bank where the SD Card driver resides
SDCBANK		=14
SDCBASE		=$4000

; bank and adddress where fast IEC and IEC dispatch resides
IECBANK		=SDCBANK
IECBASE		=$2000

;--------------------------------------------------------
; overlay code

	; actual boot code
boot	=*

        ; copy an area from flash to bank 0 RAM	
	; Note: can only write to page starts

        ; AC = page in bank 0 (8bit -> A8-15)
        ; XR = start in flash (bits 23-8)
        ; YR = number of bytes (16 bit)
loadfromflash_xl 	=boot+3

	; similar to loadfromflash, but
	; target address is overlay_start
loadoverlay_xl		=loadfromflash_xl+3

	; jump to reset vector
end			=loadoverlay_xl+3

	; the hardware DETECT_* bits
conf_detect1		=end+3
conf_detect_sid1	=conf_detect1+1
conf_detect_sid2	=conf_detect_sid1+1
	; the keyboard BOOTKBD_* bits
conf_bootkbd		=conf_detect_sid2+1
	; the keyboard OPT?_* bits
opt0			=conf_bootkbd+1
opt1			=opt0+1
opt2			=opt1+1
optu			=opt2+1
	; 

	overlay_start=boot+BOOT_LENGTH

#ifdef OVERLAY
	*=overlay_start

#else
;--------------------------------------------------------
; actual boot code

	.(
	.assert boot = *, "address mismatch"
	jmp overlay_start

        ; copy an area from flash to bank 0 RAM	
	; Note: can only write to page starts
	;
	; Needs to be called with Mx,
	; i.e. 8 bit AC, 16 bit index registers

        ; AC = page in bank 0 (8bit -> A8-15)
        ; XR = start in flash (bits 23-8)
        ; YR = number of bytes (16 bit)
	.assert loadfromflash_xl = *, "address mismatch"
	jmp jmploadspi_xl

	; similar to loadfromflash, but
	; target address is overlay_start
	.assert loadoverlay_xl = *, "address mismatch"
	jmp jmploadoverlay_xl

	.assert end = *, "address mismatch"
	jmp jmpend

	; the DETECT_* bits
	.assert conf_detect1 = *, "address mismatch"
	.byt 0
	.byt 0,0

	; the keyboard BOOTKBD_* bits
	.assert conf_bootkbd = *, "address mismatch"
	.byt 0

	; the menu OPT?_* bits
	.assert opt0 = *, "address mismatch"
	.byt 0,0,0,0

	; -----------------------------------------------
	.xl
	.as

jmploadoverlay_xl
	.assert (overlay_start & $ff) = 0, "overlay_start mismatch"
	lda #>overlay_start
	jsr jmploadspi_xl
	jmp overlay_start

jmploadspi_xl .(
        pha
	
        lda #1
        sta SPICTRL     ; enable Flash
        lda #3
        sta SPIDATA     ; READ command

	rep #%00100000
	.al
	txa		; 16 bit transfer
	sep #%00100000
	.as		; back to 8bit
	xba		; switch upper and lower bytes
        sta SPIDATA     ; bits 23-16
	xba		; switch upper and lower bytes
        sta SPIDATA     ; bits 15-8
        lda #0
        sta SPIDATA     ; bits 7-0

        lda SPIDATA     ; trigger shift in of first byte into SR (value read is still invalid)
	pla		; page in bank 0
	xba		; to upper 16 bit
	lda #0		; clear low addr byte
	tax		; 16 bit transfer
readloop
        lda SPIDATA     ; read byte, trigger shift in of next byte
        cpx #$e800      ; skip I/O window
        bcc ok
        cpx #$e900
        bcc nok
ok      sta 0,x
nok     inx
        dey
        bne readloop

        lda #SPIOFF
        sta SPICTRL     ; deselect Flash
        rts
        .)

        ; -----------------------
        ; switch back to emulation mode
jmpend
        sta MCTRL

        ; set X/Y registers to 8 bit ...
        sep #%00010000
        ; ... and tell the assembler about it
        .xs

        lda optu
        lsr
        lsr
        lsr
        lsr
        lsr
        lsr
        sta SPEED

        ; switch to native mode
        sec
        xce

        jmp ($fffc)     ; RESET vector

	.)
	 
	; fill rest of page
	.dsb boot+BOOT_LENGTH-*,$ff

	.as
	.xs
#endif
;--------------------------------------------------------
