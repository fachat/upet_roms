
; code to detect hardware and set appropriate detection bits
; in 
;	detect_bits

	.xs
; ----------------------------
	; detect logic
detect_xs .(

	lda #0
	sta conf_detect1
	lda #DETECT_SID_NONE
	sta conf_detect_sid1
	sta conf_detect_sid2

	;-- detect UART 1 at $e818
	; to detect a UART 16550 

; ---------------------
	.(
UART	=UART1
        ldy UART+UART_MCR
        lda #$10
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        bne nodev
        lda #$1f
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        cmp #$f0
        bne nodev

	; disable interrupts
	lda #0
	sta UART+UART_LCR
	sta UART+UART_IER

	lda #DETECT1_UART1
	jsr add_detect

nodev	sty UART+UART_MCR	; restore potential PIA register
	.)

; ---------------------
	.(
UART	=UART2
        ldy UART+UART_MCR
        lda #$10
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        bne nodev
        lda #$1f
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        cmp #$f0
        bne nodev

	; disable interrupts
	lda #0
	sta UART+UART_LCR
	sta UART+UART_IER

	lda #DETECT1_UART2
	jsr add_detect

nodev	sty UART+UART_MCR	; restore potential PIA register
	.)

; ---------------------
	; detect 1st VIA
	.(
	lda VIA1+VIA_PCR
	and #%00010001
	sta VIA1+VIA_PCR
	cmp VIA1+VIA_PCR
	bne nodev
	ora #%01100110
	sta VIA1+VIA_PCR
	cmp VIA1+VIA_PCR
	bne nodev

	; disable interrupts
	lda #%01111111
	sta VIA1+VIA_IER

	; uppercase characters
	lda #12
	sta VIA1+VIA_PCR

	lda #DETECT1_VIA1
	jsr add_detect
nodev	
	.)
	; ---------------------
	; detect 2nd VIA
	.(
	lda VIA2+VIA_PCR
	and #%00010001
	sta VIA2+VIA_PCR
	cmp VIA2+VIA_PCR
	bne nodev
	ora #%01100110
	sta VIA2+VIA_PCR
	cmp VIA2+VIA_PCR
	bne nodev

	; disable interrupts
	lda #%01111111
	sta VIA2+VIA_IER

	lda #DETECT1_VIA2
	jsr add_detect
nodev	
	.)

; ---------------------
	; TODO
	; detect PIA1
	; detect PIA2

	.(
	; disable interrupts
	lda #0
	sta PIA1+PIA_CRA
	sta PIA1+PIA_CRB
	sta PIA2+PIA_CRA
	sta PIA2+PIA_CRB

	lda #DETECT1_PIA1 + DETECT1_PIA2
	jsr add_detect
	.)
; ---------------------

	.(
	; TODO: detect DAC
DAC_CTRL=$15

	; disable
	lda #0
	sta DAC+DAC_CTRL
	
	lda #DETECT1_DAC
	jsr add_detect
	.)
; ---------------------

	.(
	; TODO: detect ethernet
        ; switch Ethernet - if exists - to low power mode
        lda #4                  ; ENC28J60 ethernet module
        sta SPICTRL
        lda #%01011110          ; write control register ECON2
        sta SPIDATA
        lda #%00101000          ; set PWRSV and VRPS
        sta SPIDATA
        lda #SPIOFF
        sta SPICTRL
	.)
; ---------------------
	; VICCY

        ; set Viccy registers                                              
        ; note: stored backwards, so alt/compat modes are set              
        ; before affected registers are written to                         
        .xs                                                                
&setviccy_xs .(                                                           
        ldy #41                                                           
        sty VICCY         ; register number                               
l0      lda vdctab,y                                                      
        sty VICCY                                                          
        sta VICCY+1       ; register value w/o auto-inc of register number 
lx      dey                                                               
        bpl l0                                                            
                                                                          
        ; disable sprites                                                  
        ldx #8                                                             
        ldy #0                                                             
        lda #51                                                            
sl      sta VICCY                                                          
        sty VICCY+1                                                        
        clc                                                                
        adc #4                                                             
        dex                                                                
        bne sl                                                             

	lda #DETECT1_VICCY2
	jsr add_detect
	.)

	; ---------------------

	rts

	; ---------------------
add_detect .(
	ora conf_detect1
	sta conf_detect1
	rts
	.)

vdctab 	.byt 0          ; r0 ignored
        .byt 40         ; r1 number of chars per line displayed
        .byt 0,0,0,0    ; r2-5 ignored
        .byt 25         ; r6 char rows displayed
        .byt 0          ; r7 ignored
        .byt 0          ; r8: b7= 80 col mode; b1=interlace, b0=double
        .byt 7          ; r9: rows per char (-1)
        .byt 32         ; r10: cursor start (b0-4, b6/5= mode, 00=solid, 01=off, 1x= blink)
        .byt 7          ; r11: cursor end line
        .byt >$1000     ; r12: start of vid memory high (upet compat -> $9xxx in video bank)
        .byt <$1000     ; r13: start of vid memory low (upet compat -> $9xxx in video bank)
        .byt >$1000     ; r14: cursor pos high
        .byt <$1000     ; r15: cursor pos low
        .byt 0,0,0,0    ; r16-r19: ignored
        .byt >$d000     ; r20: start of attribute memory high
        .byt <$d000     ; r21: start of attribute memory low
        .byt 9          ; r22: number of bits displayed of a char (horizontal)
        .byt 15         ; r23: displayed number of rows per char
        .byt 0          ; r24: b0-3 scroll down, b4: up/low border ext, b5 blink rate, b6: reverse
        .byt 0          ; r25: b0-3 scroll right, b4: l/r border ext, b6: attrib enable, b7: bitmap mode
        .byt BOOTCOL    ; r26: b0-3: bg colour, b4-7: fg colour
        .byt 0          ; r27: address incr
        .byt >$0000     ; r28: char set address high
        .byt 7          ; r29: underline scanline
        .byt 0,0        ; r30/31: rasterline counter low/high
        .byt 128+4+16   ; r32: b2: extended (cpet compat), b4: disp en, b7: upet compat
        .byt $0f        ; r33: b0-3: bg colour 1, b4-7: bg colour 2
        .byt BRDCOL     ; r34: border colour (b0-3)
        .byt 0          ; r35: irq control
        .byt 127        ; r36: irq status (clear all sources)
        .byt 0          ; r37: v/h sync status (VDC)
#ifdef CLK70M
        .byt 21         ; r38: horizontal position (chars)
        .byt 110        ; r39: vertical position (rasterlines)
#else
        .byt 9         ; r38: horizontal position (chars)
        .byt 79        ; r39: vertical position (rasterlines)
#endif
        .byt 0          ; r40: alt match
        .byt 0          ; r41: alt raster row

.)
