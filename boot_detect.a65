
; code to detect hardware and set appropriate detection bits
; in 
;	detect_bits

	.xs
	; ----------------------------
	; detect logic
detect_xs .(

	lda #0
	sta conf_detect1
	lda #DETECT_SID_NONE
	sta conf_detect_sid1
	sta conf_detect_sid2

	;-- detect UART 1 at $e818
	; to detect a UART 16550 

	; ---------------------
	.(
UART	=UART1
        ldy UART+UART_MCR
        lda #$10
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        bne nodev
        lda #$1f
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        cmp #$f0
        bne nodev

	; disable interrupts
	lda #0
	sta UART+UART_LCR
	sta UART+UART_IER

	lda #DETECT1_UART1
	jsr add_detect

nodev	sty UART+UART_MCR	; restore potential PIA register
	.)

	; ---------------------
	.(
UART	=UART2
        ldy UART+UART_MCR
        lda #$10
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        bne nodev
        lda #$1f
        sta UART+UART_MCR
        lda UART+UART_MSR
        and #$f0
        cmp #$f0
        bne nodev

	; disable interrupts
	lda #0
	sta UART+UART_LCR
	sta UART+UART_IER

	lda #DETECT1_UART2
	jsr add_detect

nodev	sty UART+UART_MCR	; restore potential PIA register
	.)

	; ---------------------
	; detect 1st VIA
	.(
	lda VIA1+VIA_PCR
	and #%00010001
	sta VIA1+VIA_PCR
	cmp VIA1+VIA_PCR
	bne nodev
	ora #%01100110
	sta VIA1+VIA_PCR
	cmp VIA1+VIA_PCR
	bne nodev

	; disable interrupts
	lda #%01111111
	sta VIA1+VIA_IER

	lda #DETECT1_VIA1
	jsr add_detect
nodev	
	.)
	; ---------------------
	; detect 2nd VIA
	.(
	lda VIA2+VIA_PCR
	and #%00010001
	sta VIA2+VIA_PCR
	cmp VIA2+VIA_PCR
	bne nodev
	ora #%01100110
	sta VIA2+VIA_PCR
	cmp VIA2+VIA_PCR
	bne nodev

	; disable interrupts
	lda #%01111111
	sta VIA2+VIA_IER

	lda #DETECT1_VIA2
	jsr add_detect
nodev	
	.)

	; ---------------------
	; TODO
	; detect PIA1
	; detect PIA2

	; disable interrupts
	lda #0
	sta PIA1+PIA_CRA
	sta PIA1+PIA_CRB
	sta PIA2+PIA_CRA
	sta PIA2+PIA_CRB

	lda #DETECT1_PIA1 + DETECT1_PIA2
	jsr add_detect
	; ---------------------

	.(
	; TODO: detect DAC
DAC_CTRL=$15

	; disable
	lda #0
	sta DAC+DAC_CTRL
	
	lda #DETECT1_DAC
	jsr add_detect
	; ---------------------
	rts
	.)

	; ---------------------
add_detect .(
	ora conf_detect1
	sta conf_detect1
	rts
	.)

.)
