
.(


DRIVERADDR      =IOEBASE

#include "boot_ser.i65"

        ; -----------------------                                        
        ; copy over IOExt code to RAM                                      
        ; $1a000-$1bfff in flash img                                     
        ; copy to DRIVERADDR                                                

	.xl
&setup_ser_xl                                                                         
        .(                                                               
        lda #IOEBANK 	; 
        sta BANK        ; $e802                                           

	.assert (DRIVERADDR & $ff) = 0, "page boundary"
	lda #DRIVERADDR>>8
	ldx #FLASH_IOEXT
	ldy #FLASH_IOEXT_L
	jsr loadfromflash_xl

	sep #$10
	.xs
	jsr DRIVERADDR	; reset the code
	sec
	jsr BOOT_ENABLE	; start receiving
	rep #$10
	.xl

        lda #MAP_BAS
        sta BANK
	rts
	.)

	; tear it down
&tear_ser_xl .(
	clc
	.byt $24
&enable_xl
	sec
	sei
	php
        lda #IOEBANK 	; 
        sta BANK        ; $e802                                           
	sep #$10
	.xs
	jsr BOOT_ENABLE	; start / stop receiving
	rep #$10
	.xl
        lda #MAP_BAS
        sta BANK
	plp
	rts
	.)

	.xs
	;-----------------------------
	; interrupt during boot code
&key_ser .(
	lda #IOEBANK
	sta BANK
	jsr IO_IRQ

	jsr BOOT_GET
	bcs nokey

	cmp #13		; CR
	beq output_serinfo

	sta opt

	; TODO identify the actual serial being used
	ldx #BOOTKBD_SER1+BOOTKBD_SER2
	.byt $2c
nokey	ldx #0
	lda #MAP_BAS
	sta BANK
	txa
	jmp add_bootkbd

output_serinfo 
	ldy #0
l	lda msg,y
	beq nokey
	phy
	jsr BOOT_PUT
	ply
	iny
	bne l

msg	.asc 13, "ULTI-PET BOOT (4,6,8)",13,10,0
	.)

	.xs                                                                         

.)

