
.(

tmp	=$0780ff	; last byte in stack on BLK 15

&MAP_SDC	=14	; bank 7, lower half

SDCBASE =$4000                                   

        ; -----------------------                                        
        ; copy over SD Card code to RAM                                      
        ; $1c000-$1dfff in flash img                                     
        ; copy to SDCBASE                                                

	.xl
&setup_sdcard_xl
        .(
        lda #MAP_SDC 	; which RAM bank to use for SDCard support
        sta BANK        ; $e802                                           

	.assert (SDCBASE & $ff) = 0, "page boundary"
	lda #SDCBASE >> 8
	ldx #FLASH_DOS
	ldy #FLASH_DOS_L
	jsr loadfromflash_xl

        lda #MAP_BAS	; switch back to bank 0
        sta BANK                                                         

	rts
        .)                                                               

.)

