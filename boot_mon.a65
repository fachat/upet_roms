
.(

;MONBANK	=15
;MONBASE	=$5000

directpage=$1f00


        ; -----------------------                                        
        ; copy over monitor code to RAM                                      
        ; $1a000-$1bfff in flash img                                     
        ; copy to DRIVERADDR                                                

	.xl
&mon_setup_xl                                                                         
        .(                                                               
        lda #MONBANK 	; 
        sta BANK        ; $e802                                           

	.assert (MONBASE & $ff) = 0, "page boundary"
	lda #MONBASE >> 8
	ldx #FLASH_MON
	ldy #FLASH_MON_L
	jsr loadfromflash_xl

        lda #MAP_BAS
        sta BANK
	rts
	.)

.)

