
USB_DRIVERADDRESS	=USBBASE

#include "usb65/platforms/upet/usbrom.i65"

lock		=(USBBANK<<15) + $00ff
BOOT_VCOUNT	=(USBBANK<<15) + $00fe

.(

        ; -----------------------                                        
        ; copy over USB code to RAM                                      
        ; $1a000-$1bfff in flash img                                     
        ; copy to DRIVERADDR                                                

	.xl
&setup_usb_xl                                                                         
        .(                                                               
        lda #USBBANK 	; for the PET default VICCY base address of $1000 
        sta BANK        ; $e802                                           

	.assert (USB_DRIVERADDRESS & $ff) = 0, "page boundary"
	lda #USB_DRIVERADDRESS >> 8
	ldx #FLASH_USB
	ldy #FLASH_USB_L
	jsr loadfromflash_xl

	; link companion and driver
	ldx #t_pause
	stx usb_drv_pause_cb_addr
	ldx #t_printc2
	stx usb_drv_print_cb_addr

	sep #%00010000
	.xs

	jsr t_init
    	bcs nohw
       
	jsr t_install
 
        ; TODO:                                                          
        ; 2. init USB, bind into IRQ                                     
        ; 3. CLI                                                         
        ; 4. then use USB keyboard in boot menu                          
        ; 5. SEI                                                         
        ; 6. set ROMs                                                    
        ; 7. if USB option set, copy real bind companion to $df00        
        ; 8. enable USB interrupt handling                               
        ; 9. switch BANK back to 0 ($20)                                 
        ; 10. boot into ROM                                              
         
nohw                                                               
        lda #MAP_BAS
        sta BANK                                                         

	rep #%00010000
	.xl
	rts
        .)                                                               

	

	.xs                                                                         

&usb_poll .(
        lda #USBBANK    
        sta BANK      
                       
        jsr usb_drv_polldev 

        lda #MAP_BAS     
        sta BANK      
	rts
	.)

t_install .(
	; interrupt is already established for key scanning
	; we just need to release the lock
	lda #0
	sta lock

	rts
	.)

	; is entered in USBBANK, .xs, .as
t_init    .(
	php                         
	sei                         
	
	lda #<-1                    
	sta lock                    
	
	jsr usb_drv_init             
	
	bcs locked                  
	plp                         
	clc                         
	rts
	
locked	plp                         
	sec                         
	rts                         
	.)

t_uninstall .(
	sei

	lda #<-1
	sta lock
	rts
	.)


	; pause a given number of vertical scree
	; in AC has number of frames (retraces) 
	.xs
	.as
t_pause .(                              
	php
	lda #MAP_BAS
	sta BANK
	cli
	
	tax                             
	inx           ; full retraces, s
p0	lda BOOT_VCOUNT                      
p1	cmp BOOT_VCOUNT                      
	beq p1                          
	dex                             
	bne p0                          
	
	lda #USBBANK
	sta BANK
	plp
	rts                             
	.)                              


t_printc2 .(
	tax             ; actually overwrites modifiers in X
	php
	sei
	
	bcs stop
	
	;inc $8027
	
	lda #MAP_BAS
	sta BANK
	
	txa
	jsr key_usb
stop
	lda #USBBANK
	sta BANK
	
	plp
	rts
        .)

&tear_usb=t_uninstall
.)

